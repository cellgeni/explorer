{
  "name": "spatial-omics-explorer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "examples": "node scripts/examples-index.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@cornerstonejs/codec-openjpeg": "1.3.6",
    "@deck.gl/core": "9.4.2",
    "@deck.gl/extensions": "9.4.2",
    "@deck.gl/layers": "9.4.2",
    "@deck.gl/react": "9.4.2",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@luma.gl/engine": "9.4.2",
    "@math.gl/polygon": "4.1.1",
    "@zarrita/storage": "0.2.1",
    "geotiff": "3.0.5",
    "h5wasm": "0.10.3",
    "hyparquet": "1.33.2",
    "hyparquet-compressors": "1.1.3",
    "icechunk-js": "0.7.1",
    "pyodide": "314.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zarrita": "0.7.6",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "patch-package": "8.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
