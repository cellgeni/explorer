{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explorer-manifest.v1.json",
  "title": "Spatial Omics Explorer dataset manifest",
  "description": "Optional explorer.json for a hosted dataset: which platform it is, where its files are, and how the viewer shows it on first load. Relative paths resolve against the manifest's folder, or against `root` when set.",
  "type": "object",
  "required": ["version", "platform"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "const": 1,
      "description": "Manifest format version."
    },
    "platform": {
      "enum": [
        "xenium",
        "atera",
        "visium",
        "visium-hd",
        "merscope",
        "h5ad",
        "spatialdata",
        "image"
      ],
      "description": "How to read the dataset."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Display name, shown in the log and diagnostics."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "What the dataset shows, shown in the info drawer's About section."
    },
    "source": { "$ref": "#/$defs/source" },
    "root": {
      "$ref": "#/$defs/path",
      "description": "Base for relative paths instead of the manifest's folder. Relative to the manifest, or an http(s) URL."
    },
    "files": { "type": "object" },
    "options": { "type": "object" },
    "defaults": { "$ref": "#/$defs/defaults" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "xenium" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/xeniumFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "atera" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/ateraFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "visium" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/visiumFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "visium-hd" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/visiumHdFiles" },
          "options": { "$ref": "#/$defs/visiumHdOptions" }
        },
        "$comment": "options.binSize must be one of files.bins when that is given.",
        "allOf": [
          {
            "if": {
              "required": ["files", "options"],
              "properties": {
                "files": { "required": ["bins"] },
                "options": {
                  "required": ["binSize"],
                  "properties": { "binSize": { "const": 2 } }
                }
              }
            },
            "then": {
              "properties": {
                "files": {
                  "properties": {
                    "bins": {
                      "contains": {
                        "required": ["size"],
                        "properties": { "size": { "const": 2 } }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": ["files", "options"],
              "properties": {
                "files": { "required": ["bins"] },
                "options": {
                  "required": ["binSize"],
                  "properties": { "binSize": { "const": 8 } }
                }
              }
            },
            "then": {
              "properties": {
                "files": {
                  "properties": {
                    "bins": {
                      "contains": {
                        "required": ["size"],
                        "properties": { "size": { "const": 8 } }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": ["files", "options"],
              "properties": {
                "files": { "required": ["bins"] },
                "options": {
                  "required": ["binSize"],
                  "properties": { "binSize": { "const": 16 } }
                }
              }
            },
            "then": {
              "properties": {
                "files": {
                  "properties": {
                    "bins": {
                      "contains": {
                        "required": ["size"],
                        "properties": { "size": { "const": 16 } }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "platform": { "const": "merscope" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/merscopeFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "h5ad" } } },
      "then": {
        "required": ["files"],
        "$comment": "options.coordinates needs files.image, and options.labelColumn files.labels.",
        "allOf": [
          {
            "if": {
              "required": ["options"],
              "properties": { "options": { "required": ["coordinates"] } }
            },
            "then": { "properties": { "files": { "required": ["image"] } } }
          },
          {
            "if": {
              "required": ["options"],
              "properties": { "options": { "required": ["labelColumn"] } }
            },
            "then": { "properties": { "files": { "required": ["labels"] } } }
          }
        ],
        "properties": {
          "files": {
            "type": "object",
            "required": ["h5ad"],
            "properties": {
              "h5ad": {
                "$ref": "#/$defs/path",
                "description": "The .h5ad file, an AnnData Zarr store, or an Icechunk repository holding AnnData."
              },
              "image": {
                "$ref": "#/$defs/path",
                "description": "An image to show under the cells: OME-Zarr, OME-TIFF, TIFF, QPTIFF, SVS or NDPI."
              },
              "labels": {
                "$ref": "#/$defs/path",
                "description": "An OME-Zarr segmentation label image covering `image`, drawn as cell boundaries. Label N outlines the cell whose label value is N (see `labelColumn`). Needs `image`."
              }
            },
            "dependentRequired": { "labels": ["image"] },
            "additionalProperties": false
          },
          "options": {
            "type": "object",
            "properties": {
              "coordinates": {
                "enum": ["micrometers", "image-pixels"],
                "default": "micrometers",
                "description": "What the table's cell coordinates are in: micrometres, or the image's full-resolution pixels, which are scaled to micrometres by the image's pixel size. Needs `files.image`."
              },
              "labelColumn": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "The obs column holding each cell's label value: whole numbers, or strings of them. Without it, the table's SpatialData instance key, else the shortest obs column named like \"label\", whichever holds whole numbers for most cells; else the obs names. Needs `files.labels`."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "spatialdata" } } },
      "then": {
        "required": ["files"],
        "properties": {
          "files": {
            "type": "object",
            "required": ["store"],
            "properties": {
              "store": {
                "$ref": "#/$defs/path",
                "description": "The SpatialData Zarr store root."
              }
            },
            "additionalProperties": false
          },
          "options": { "$ref": "#/$defs/spatialDataOptions" }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "image" } } },
      "then": {
        "required": ["files"],
        "$comment": "Segmentation options need files.segmentation; a segmentation with an extension the viewer does not read needs options.segmentationFormat; files.zchunkstore is only for a TIFF image.",
        "allOf": [
          {
            "if": {
              "required": ["options"],
              "properties": {
                "options": {
                  "anyOf": [
                    { "required": ["segmentationFormat"] },
                    { "required": ["segmentationCoordinates"] }
                  ]
                }
              }
            },
            "then": { "properties": { "files": { "required": ["segmentation"] } } }
          },
          {
            "if": {
              "properties": {
                "files": {
                  "required": ["segmentation"],
                  "properties": {
                    "segmentation": {
                      "type": "string",
                      "not": {
                        "pattern": "^[^?#]*(?:\\.(?:[Oo][Mm][Ee]\\.)?[Tt][Ii][Ff][Ff]?|\\.[Zz][Aa][Rr][Rr]|/\\.[Zz][Aa][Tt][Tt][Rr][Ss]|\\.(?:[Gg][Ee][Oo])?[Jj][Ss][Oo][Nn]|\\.(?:[Gg][Ee][Oo])?[Pp][Aa][Rr][Qq][Uu][Ee][Tt]|\\.[Pp][Qq]|\\.(?:[Ww][Kk][Tt]|[Cc][Ss][Vv]|[Tt][Ss][Vv]|[Tt][Xx][Tt]))(?:\\.[Gg][Zz])?/*\\s*(?:[?#][\\s\\S]*)?$"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "required": ["options"],
              "properties": { "options": { "required": ["segmentationFormat"] } }
            }
          },
          {
            "if": {
              "properties": {
                "files": {
                  "required": ["image", "zchunkstore"],
                  "properties": {
                    "image": {
                      "type": "string",
                      "pattern": "^[^?#]*(?:\\.zarr/*|(?:^|/)(?:zarr\\.json|\\.zattrs)/*|\\.zarr/(?:[^/]+/)*[^/.]+/*|\\.icechunk/*|\\.zip/*)\\s*$"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": { "files": { "properties": { "zchunkstore": false } } }
            }
          }
        ],
        "properties": {
          "files": {
            "type": "object",
            "required": ["image"],
            "properties": {
              "image": {
                "$ref": "#/$defs/path",
                "description": "OME-TIFF, TIFF, QPTIFF, SVS, NDPI, or OME-Zarr image."
              },
              "zchunkstore": {
                "$ref": "#/$defs/path",
                "description": "`.zchunkstore` tile-offset sidecar for a TIFF `image` and its channel files. Replaces the default lookup next to the TIFF. Not allowed with an OME-Zarr `image`."
              },
              "segmentation": {
                "$ref": "#/$defs/path",
                "description": "A segmentation shown as outlines over the image: a label mask (TIFF or OME-Zarr) or polygons (GeoJSON, WKT text or CSV, Parquet). The format comes from the extension unless `options.segmentationFormat` sets it."
              }
            },
            "additionalProperties": false
          },
          "options": {
            "type": "object",
            "properties": {
              "segmentationFormat": {
                "anyOf": [
                  { "enum": ["label-tiff", "label-zarr", "geojson", "wkt", "parquet"] },
                  {
                    "type": "string",
                    "pattern": "^\\s*(?:label-tiff|label-zarr|geojson|wkt|parquet)\\s*$"
                  }
                ],
                "description": "The format of `files.segmentation` when its extension does not tell it."
              },
              "segmentationCoordinates": {
                "anyOf": [
                  { "enum": ["pixels", "micrometers"] },
                  { "type": "string", "pattern": "^\\s*(?:pixels|micrometers)\\s*$" }
                ],
                "description": "What the polygon coordinates of `files.segmentation` are in. Default `pixels` (full-resolution image pixels). Label masks are placed over the image whatever this says."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)(?![A-Za-z][A-Za-z0-9+.-]*:)|^[Hh][Tt][Tt][Pp][Ss]?://",
      "description": "A path relative to the manifest folder (or `root`), or an http(s) URL."
    },
    "source": {
      "type": "object",
      "description": "Where the data comes from, shown in the info drawer's About section.",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Repository or host, such as BioImage Archive."
        },
        "accession": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Accession or identifier in that repository."
        },
        "url": {
          "type": "string",
          "pattern": "^\\s*[Hh][Tt][Tt][Pp][Ss]?://[^/]",
          "description": "Landing page for the deposit."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Data licence, such as CC BY 4.0."
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "How to cite the data."
        }
      },
      "additionalProperties": false
    },
    "xeniumFiles": {
      "type": "object",
      "description": "Xenium files that are not at their standard XOA names. Omitted files use the standard name.",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/path",
          "description": "Default experiment.xenium. Optional with a manifest: it supplies the pixel size and, when `morphology` is not set, the morphology image paths."
        },
        "cells": { "$ref": "#/$defs/path", "description": "Default cells.parquet." },
        "cellBoundaries": {
          "$ref": "#/$defs/path",
          "description": "Default cell_boundaries.parquet."
        },
        "nucleusBoundaries": {
          "$ref": "#/$defs/path",
          "description": "Default nucleus_boundaries.parquet."
        },
        "transcripts": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.parquet."
        },
        "transcriptsZarr": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.zarr.zip."
        },
        "cellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.zarr.zip."
        },
        "cellFeatureMatrixH5": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.h5."
        },
        "analysis": {
          "$ref": "#/$defs/path",
          "description": "Default analysis.zarr.zip."
        },
        "genePanel": {
          "$ref": "#/$defs/path",
          "description": "Default gene_panel.json."
        },
        "morphology": {
          "$ref": "#/$defs/path",
          "description": "Morphology image. Default: the image listed in experiment.xenium."
        },
        "morphologyZchunkstore": {
          "$ref": "#/$defs/path",
          "description": "`.zchunkstore` tile-offset sidecar for the morphology image. Replaces the default lookup next to the TIFF (`<file>.zchunkstore`, then the folder and dataset root)."
        },
        "umap": {
          "$ref": "#/$defs/path",
          "description": "UMAP projection CSV. Default: searched under analysis/umap/."
        },
        "tsne": {
          "$ref": "#/$defs/path",
          "description": "t-SNE projection CSV. Default: searched under analysis/tsne/."
        }
      },
      "additionalProperties": false
    },
    "ateraFiles": {
      "type": "object",
      "description": "Atera files that are not at their standard names. Omitted files use the path in experiment.spatial, then the standard name.",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/path",
          "description": "Default experiment.spatial. Supplies the pixel size, the morphology image path, and the other file paths."
        },
        "cells": { "$ref": "#/$defs/path", "description": "Default cells.zarr.zip." },
        "cellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.zarr.zip (AnnData Zarr, CSR)."
        },
        "cscCellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default csc_cell_feature_matrix.zarr.zip (AnnData Zarr, CSC)."
        },
        "transcripts": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.zarr.zip."
        },
        "binnedTranscripts": {
          "$ref": "#/$defs/path",
          "description": "Default binned_transcripts.zarr.zip."
        },
        "morphology": {
          "$ref": "#/$defs/path",
          "description": "Morphology image. Default: the morphology_2d image listed in experiment.spatial."
        },
        "morphologyZchunkstore": {
          "$ref": "#/$defs/path",
          "description": "`.zchunkstore` tile-offset sidecar covering every morphology_2d channel file. Replaces the default lookup next to each TIFF (`<file>.zchunkstore`)."
        },
        "morphology3d": {
          "$ref": "#/$defs/path",
          "description": "3D DAPI stack, offered instead of the morphology image. Default: the morphology_3d image listed in experiment.spatial."
        }
      },
      "additionalProperties": false
    },
    "merscopeFiles": {
      "type": "object",
      "description": "Vizgen MERSCOPE region files that are not at their instrument names, such as vpt re-segmentation outputs or GEO's prefixed, gzipped files. Files named here must exist; omitted files use the instrument name.",
      "properties": {
        "cellByGene": {
          "$ref": "#/$defs/path",
          "description": "Cell-by-gene counts CSV, gzip allowed. Default cell_by_gene.csv. Read whole, up to 300 MiB."
        },
        "cellMetadata": {
          "$ref": "#/$defs/path",
          "description": "Cell metadata CSV with center_x and center_y in micrometres, gzip allowed. Default cell_metadata.csv. Read whole, up to 300 MiB."
        },
        "cellBoundaries": {
          "$ref": "#/$defs/path",
          "description": "Cell boundary GeoParquet with EntityID and ZIndex columns, gzip allowed. Default cell_boundaries.parquet; vpt writes <method>_micron_space.parquet. Read whole."
        },
        "vzg": {
          "$ref": "#/$defs/path",
          "description": "The MERSCOPE Vizualizer .vzg zip, whose image pyramids are shown one stain and z plane at a time. Default: the one .vzg the folder's index page lists. Needs byte-range support."
        }
      },
      "additionalProperties": false
    },
    "visiumFiles": {
      "type": "object",
      "description": "Standard Visium (v1/v2, 55 µm spots) Space Ranger files that are not at their standard names. Files named here must exist; omitted files use the Space Ranger name.",
      "properties": {
        "tissuePositions": {
          "$ref": "#/$defs/path",
          "description": "Spot positions CSV, gzip allowed. Default spatial/tissue_positions.csv, then the Space Ranger 1.x spatial/tissue_positions_list.csv (no header)."
        },
        "scalefactors": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/scalefactors_json.json (gzip allowed)."
        },
        "filteredMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default filtered_feature_bc_matrix.h5, then the MEX filtered_feature_bc_matrix/matrix.mtx.gz. A .mtx or .mtx.gz file (Matrix Market) is read with its barcode and feature lists. Up to 300 MiB."
        },
        "filteredMatrixBarcodes": {
          "$ref": "#/$defs/path",
          "description": "Barcode list of a MEX filteredMatrix, gzip allowed. Default: the matrix's name with matrix.mtx changed to barcodes.tsv (and a .mtx extension to .tsv)."
        },
        "filteredMatrixFeatures": {
          "$ref": "#/$defs/path",
          "description": "Feature list of a MEX filteredMatrix (id, name, type columns), gzip allowed. Default: the matrix's name with matrix.mtx changed to features.tsv, then genes.tsv."
        },
        "hiresImage": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/tissue_hires_image.png. Any image format the browser can show."
        },
        "lowresImage": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/tissue_lowres_image.png."
        },
        "clusters": {
          "$ref": "#/$defs/path",
          "description": "Barcode,Cluster CSV. Default: analysis/clustering/gene_expression_graphclust/clusters.csv, then analysis/clustering/graphclust/clusters.csv."
        },
        "umap": {
          "$ref": "#/$defs/path",
          "description": "UMAP projection CSV. Default: searched under analysis/umap/."
        },
        "tsne": {
          "$ref": "#/$defs/path",
          "description": "t-SNE projection CSV. Default: searched under analysis/tsne/."
        },
        "pca": {
          "$ref": "#/$defs/path",
          "description": "PCA projection CSV; the first two components are shown. Default: searched under analysis/pca/."
        }
      },
      "additionalProperties": false
    },
    "visiumHdFiles": {
      "type": "object",
      "properties": {
        "bins": {
          "type": "array",
          "minItems": 1,
          "$comment": "Each bin size at most once.",
          "allOf": [
            {
              "contains": { "properties": { "size": { "const": 2 } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "size": { "const": 8 } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "size": { "const": 16 } } },
              "minContains": 0,
              "maxContains": 1
            }
          ],
          "description": "Binned outputs. Default: the binned_outputs/square_002um, _008um, and _016um tiers that exist.",
          "items": {
            "type": "object",
            "required": ["size", "path"],
            "properties": {
              "size": { "enum": [2, 8, 16], "description": "Bin size in µm." },
              "path": {
                "$ref": "#/$defs/path",
                "description": "The bin's output folder, such as binned_outputs/square_008um."
              },
              "tissuePositions": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/spatial/tissue_positions.parquet."
              },
              "scalefactors": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/spatial/scalefactors_json.json."
              },
              "filteredMatrix": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/filtered_feature_bc_matrix.h5."
              }
            },
            "additionalProperties": false
          }
        },
        "featureSlice": {
          "$ref": "#/$defs/path",
          "description": "Default feature_slice.h5."
        },
        "barcodeMappings": {
          "$ref": "#/$defs/path",
          "description": "Default barcode_mappings.parquet."
        },
        "segmentedOutputs": {
          "type": "object",
          "description": "Segmented outputs. When set, only the files listed here are used. Default: the standard segmented_outputs/ files that exist.",
          "properties": {
            "scalefactors": { "$ref": "#/$defs/path" },
            "filteredMatrix": { "$ref": "#/$defs/path" },
            "rawMatrix": { "$ref": "#/$defs/path" },
            "cellSegmentations": { "$ref": "#/$defs/path" },
            "nucleusSegmentations": { "$ref": "#/$defs/path" },
            "nucleusInstanceMask": { "$ref": "#/$defs/path" },
            "graphclustCellSegmentations": { "$ref": "#/$defs/path" },
            "graphclustNucleusSegmentations": { "$ref": "#/$defs/path" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visiumHdOptions": {
      "type": "object",
      "properties": {
        "binSize": {
          "enum": [2, 8, 16],
          "description": "Bin size shown first. Default 16 µm when present, else 8 µm."
        }
      },
      "additionalProperties": false
    },
    "spatialDataOptions": {
      "type": "object",
      "description": "Starting view for the info drawer's View options. Changing the table there clears the coordinate system, image, and units; changing the coordinate system clears the image and units.",
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Table element name, without the tables/ prefix."
        },
        "coordinateSystem": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Image element name, without the images/ prefix."
        },
        "micrometersPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Micrometres per coordinate-system unit, when the store does not declare it."
        }
      },
      "additionalProperties": false
    },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "defaults": {
      "type": "object",
      "description": "Display settings on first load. A shared link's own values take precedence.",
      "properties": {
        "genes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "description": "Genes to select. Names must match the gene panel exactly."
        },
        "colorCellsBy": {
          "anyOf": [
            {
              "enum": [
                "gene-expression",
                "transcript-count",
                "cell-area",
                "annotations",
                "metadata"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*(?:gene-expression|transcript-count|cell-area|annotations|metadata)\\s*$"
            }
          ],
          "description": "The Cell color control. Without it, genes colour cells by gene expression."
        },
        "geneColorScale": {
          "anyOf": [
            {
              "enum": [
                "gold",
                "magma",
                "viridis",
                "plasma",
                "cividis",
                "teal",
                "rose",
                "glasbey"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*(?:gold|magma|viridis|plasma|cividis|teal|rose|glasbey)\\s*$"
            }
          ],
          "description": "The Gene scale control."
        },
        "geneRange": {
          "type": "array",
          "prefixItems": [
            { "type": ["number", "null"] },
            {
              "anyOf": [
                { "type": ["number", "null"] },
                {
                  "type": "string",
                  "pattern": "^p(?:0*100(?:\\.0+)?|0*[1-9][0-9]?(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$"
                }
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "The Gene scale range, [min, max]. null leaves that end on Auto (0 at the bottom, the 99th percentile of the scores above 0 at the top); max must be above min. max may also be a percentile of each dataset's scores above 0, from \"p1\" to \"p100\", such as \"p95\". Kept when the next dataset sets no range."
        },
        "geneScoreMode": {
          "anyOf": [
            { "enum": ["sum", "mean", "z-score"] },
            { "type": "string", "pattern": "^\\s*(?:sum|mean|z-score)\\s*$" }
          ],
          "description": "The Combine genes control."
        },
        "cellBoundaries": { "type": "boolean" },
        "nucleusBoundaries": { "type": "boolean" },
        "channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "description": "Image channels to turn on, by name (case-insensitive) or ID."
        },
        "imageOpacity": { "$ref": "#/$defs/opacity" },
        "cellFillOpacity": { "$ref": "#/$defs/opacity" },
        "cellBoundaryOpacity": { "$ref": "#/$defs/opacity" },
        "cellPointScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The Cell point size multiplier, from 0.5 to 32; other values snap to the nearest slider step."
        },
        "transcripts": {
          "type": "boolean",
          "description": "Show the transcript overlay (Xenium, Atera)."
        },
        "imageView": {
          "anyOf": [
            { "enum": ["2d", "3d"] },
            { "type": "string", "pattern": "^\\s*(?:2d|3d)\\s*$" }
          ],
          "description": "The Image section's View: 3d opens an OME-Zarr z-stack in the 3D view."
        },
        "cellView": {
          "anyOf": [
            { "enum": ["2d", "3d"] },
            { "type": "string", "pattern": "^\\s*(?:2d|3d)\\s*$" }
          ],
          "description": "The Cells section's View: 3d shows cells placed in 3D (a third column of AnnData obsm spatial) in the 3D view."
        }
      },
      "additionalProperties": false
    }
  }
}
