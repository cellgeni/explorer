{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explorer-manifest.v1.json",
  "title": "Spatial Omics Explorer dataset manifest",
  "description": "Optional explorer.json for a hosted dataset: which platform it is, where its files are, and how the viewer shows it on first load. Relative paths resolve against the manifest's folder, or against `root` when set.",
  "type": "object",
  "required": ["version", "platform"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "const": 1,
      "description": "Manifest format version."
    },
    "platform": {
      "enum": ["xenium", "atera", "visium", "visium-hd", "h5ad", "spatialdata", "image"],
      "description": "How to read the dataset."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name, shown in the log and diagnostics."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the dataset shows, shown in the info drawer's About section."
    },
    "source": { "$ref": "#/$defs/source" },
    "root": {
      "$ref": "#/$defs/path",
      "description": "Base for relative paths instead of the manifest's folder. Relative to the manifest, or an http(s) URL."
    },
    "files": { "type": "object" },
    "options": { "type": "object" },
    "defaults": { "$ref": "#/$defs/defaults" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "xenium" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/xeniumFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "atera" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/ateraFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "visium" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/visiumFiles" },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "visium-hd" } } },
      "then": {
        "properties": {
          "files": { "$ref": "#/$defs/visiumHdFiles" },
          "options": { "$ref": "#/$defs/visiumHdOptions" }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "h5ad" } } },
      "then": {
        "required": ["files"],
        "properties": {
          "files": {
            "type": "object",
            "required": ["h5ad"],
            "properties": {
              "h5ad": { "$ref": "#/$defs/path", "description": "The .h5ad file." }
            },
            "additionalProperties": false
          },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "spatialdata" } } },
      "then": {
        "required": ["files"],
        "properties": {
          "files": {
            "type": "object",
            "required": ["store"],
            "properties": {
              "store": {
                "$ref": "#/$defs/path",
                "description": "The SpatialData Zarr store root."
              }
            },
            "additionalProperties": false
          },
          "options": { "$ref": "#/$defs/spatialDataOptions" }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "image" } } },
      "then": {
        "required": ["files"],
        "properties": {
          "files": {
            "type": "object",
            "required": ["image"],
            "properties": {
              "image": {
                "$ref": "#/$defs/path",
                "description": "OME-TIFF, TIFF, NDPI, or OME-Zarr image."
              },
              "zchunkstore": {
                "$ref": "#/$defs/path",
                "description": "`.zchunkstore` tile-offset sidecar for a TIFF `image` and its channel files. Replaces the default lookup next to the TIFF. Not allowed with an OME-Zarr `image`."
              }
            },
            "additionalProperties": false
          },
          "options": { "type": "object", "maxProperties": 0 }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)|^[Hh][Tt][Tt][Pp][Ss]?://",
      "description": "A path relative to the manifest folder (or `root`), or an http(s) URL."
    },
    "source": {
      "type": "object",
      "description": "Where the data comes from, shown in the info drawer's About section.",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Repository or host, such as BioImage Archive."
        },
        "accession": {
          "type": "string",
          "minLength": 1,
          "description": "Accession or identifier in that repository."
        },
        "url": {
          "type": "string",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/]",
          "description": "Landing page for the deposit."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "Data licence, such as CC BY 4.0."
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "description": "How to cite the data."
        }
      },
      "additionalProperties": false
    },
    "xeniumFiles": {
      "type": "object",
      "description": "Xenium files that are not at their standard XOA names. Omitted files use the standard name.",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/path",
          "description": "Default experiment.xenium. Optional with a manifest: it supplies the pixel size and, when `morphology` is not set, the morphology image paths."
        },
        "cells": { "$ref": "#/$defs/path", "description": "Default cells.parquet." },
        "cellBoundaries": {
          "$ref": "#/$defs/path",
          "description": "Default cell_boundaries.parquet."
        },
        "transcripts": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.parquet."
        },
        "transcriptsZarr": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.zarr.zip."
        },
        "cellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.zarr.zip."
        },
        "cellFeatureMatrixH5": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.h5."
        },
        "analysis": {
          "$ref": "#/$defs/path",
          "description": "Default analysis.zarr.zip."
        },
        "genePanel": {
          "$ref": "#/$defs/path",
          "description": "Default gene_panel.json."
        },
        "morphology": {
          "$ref": "#/$defs/path",
          "description": "Morphology image. Default: the image listed in experiment.xenium."
        },
        "morphologyZchunkstore": {
          "$ref": "#/$defs/path",
          "description": "`.zchunkstore` tile-offset sidecar for the morphology image. Replaces the default lookup next to the TIFF (`<file>.zchunkstore`, then the folder and dataset root)."
        },
        "umap": {
          "$ref": "#/$defs/path",
          "description": "UMAP projection CSV. Default: searched under analysis/umap/."
        },
        "tsne": {
          "$ref": "#/$defs/path",
          "description": "t-SNE projection CSV. Default: searched under analysis/tsne/."
        }
      },
      "additionalProperties": false
    },
    "ateraFiles": {
      "type": "object",
      "description": "Atera files that are not at their standard names. Omitted files use the path in experiment.spatial, then the standard name.",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/path",
          "description": "Default experiment.spatial. Supplies the pixel size, the morphology image path, and the other file paths."
        },
        "cells": { "$ref": "#/$defs/path", "description": "Default cells.zarr.zip." },
        "cellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default cell_feature_matrix.zarr.zip (AnnData Zarr, CSR)."
        },
        "cscCellFeatureMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default csc_cell_feature_matrix.zarr.zip (AnnData Zarr, CSC)."
        },
        "transcripts": {
          "$ref": "#/$defs/path",
          "description": "Default transcripts.zarr.zip."
        },
        "binnedTranscripts": {
          "$ref": "#/$defs/path",
          "description": "Default binned_transcripts.zarr.zip."
        },
        "morphology": {
          "$ref": "#/$defs/path",
          "description": "Morphology image. Default: the morphology_2d image listed in experiment.spatial."
        },
        "morphologyZchunkstore": {
          "$ref": "#/$defs/path",
          "description": "`.zchunkstore` tile-offset sidecar covering every morphology_2d channel file. Replaces the default lookup next to each TIFF (`<file>.zchunkstore`)."
        }
      },
      "additionalProperties": false
    },
    "visiumFiles": {
      "type": "object",
      "description": "Standard Visium (v1/v2, 55 µm spots) Space Ranger files that are not at their standard names. Files named here must exist; omitted files use the Space Ranger name.",
      "properties": {
        "tissuePositions": {
          "$ref": "#/$defs/path",
          "description": "Spot positions CSV, gzip allowed. Default spatial/tissue_positions.csv, then the Space Ranger 1.x spatial/tissue_positions_list.csv (no header)."
        },
        "scalefactors": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/scalefactors_json.json (gzip allowed)."
        },
        "filteredMatrix": {
          "$ref": "#/$defs/path",
          "description": "Default filtered_feature_bc_matrix.h5. Read whole, up to 300 MB."
        },
        "hiresImage": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/tissue_hires_image.png. Any image format the browser can show."
        },
        "lowresImage": {
          "$ref": "#/$defs/path",
          "description": "Default spatial/tissue_lowres_image.png."
        },
        "clusters": {
          "$ref": "#/$defs/path",
          "description": "Barcode,Cluster CSV. Default: analysis/clustering/gene_expression_graphclust/clusters.csv, then analysis/clustering/graphclust/clusters.csv."
        },
        "umap": {
          "$ref": "#/$defs/path",
          "description": "UMAP projection CSV. Default: searched under analysis/umap/."
        },
        "tsne": {
          "$ref": "#/$defs/path",
          "description": "t-SNE projection CSV. Default: searched under analysis/tsne/."
        },
        "pca": {
          "$ref": "#/$defs/path",
          "description": "PCA projection CSV; the first two components are shown. Default: searched under analysis/pca/."
        }
      },
      "additionalProperties": false
    },
    "visiumHdFiles": {
      "type": "object",
      "properties": {
        "bins": {
          "type": "array",
          "minItems": 1,
          "description": "Binned outputs. Default: the binned_outputs/square_002um, _008um, and _016um tiers that exist.",
          "items": {
            "type": "object",
            "required": ["size", "path"],
            "properties": {
              "size": { "enum": [2, 8, 16], "description": "Bin size in µm." },
              "path": {
                "$ref": "#/$defs/path",
                "description": "The bin's output folder, such as binned_outputs/square_008um."
              },
              "tissuePositions": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/spatial/tissue_positions.parquet."
              },
              "scalefactors": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/spatial/scalefactors_json.json."
              },
              "filteredMatrix": {
                "$ref": "#/$defs/path",
                "description": "Default <path>/filtered_feature_bc_matrix.h5."
              }
            },
            "additionalProperties": false
          }
        },
        "featureSlice": {
          "$ref": "#/$defs/path",
          "description": "Default feature_slice.h5."
        },
        "barcodeMappings": {
          "$ref": "#/$defs/path",
          "description": "Default barcode_mappings.parquet."
        },
        "segmentedOutputs": {
          "type": "object",
          "description": "Segmented outputs. When set, only the files listed here are used. Default: the standard segmented_outputs/ files that exist.",
          "properties": {
            "scalefactors": { "$ref": "#/$defs/path" },
            "filteredMatrix": { "$ref": "#/$defs/path" },
            "rawMatrix": { "$ref": "#/$defs/path" },
            "cellSegmentations": { "$ref": "#/$defs/path" },
            "nucleusSegmentations": { "$ref": "#/$defs/path" },
            "nucleusInstanceMask": { "$ref": "#/$defs/path" },
            "graphclustCellSegmentations": { "$ref": "#/$defs/path" },
            "graphclustNucleusSegmentations": { "$ref": "#/$defs/path" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visiumHdOptions": {
      "type": "object",
      "properties": {
        "binSize": {
          "enum": [2, 8, 16],
          "description": "Bin size shown first. Default 16 µm when present, else 8 µm."
        }
      },
      "additionalProperties": false
    },
    "spatialDataOptions": {
      "type": "object",
      "description": "Starting view for the info drawer's View options. Changing the coordinate system there clears the image and units.",
      "properties": {
        "coordinateSystem": { "type": "string", "minLength": 1 },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Image element name, without the images/ prefix."
        },
        "micrometersPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Micrometres per coordinate-system unit, when the store does not declare it."
        }
      },
      "additionalProperties": false
    },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "defaults": {
      "type": "object",
      "description": "Display settings on first load. A shared link's own values take precedence.",
      "properties": {
        "genes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Genes to select. Names must match the gene panel exactly."
        },
        "colorCellsBy": {
          "enum": [
            "gene-expression",
            "transcript-count",
            "cell-area",
            "annotations",
            "metadata"
          ],
          "description": "The Cell color control. Without it, genes colour cells by gene expression."
        },
        "geneColorScale": {
          "enum": [
            "gold",
            "magma",
            "viridis",
            "plasma",
            "cividis",
            "teal",
            "rose",
            "glasbey"
          ],
          "description": "The Gene scale control."
        },
        "geneScoreMode": {
          "enum": ["sum", "mean", "z-score"],
          "description": "The Signature score control."
        },
        "cellBoundaries": { "type": "boolean" },
        "nucleusBoundaries": { "type": "boolean" },
        "channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Image channels to turn on, by name (case-insensitive) or ID."
        },
        "imageOpacity": { "$ref": "#/$defs/opacity" },
        "cellFillOpacity": { "$ref": "#/$defs/opacity" },
        "cellBoundaryOpacity": { "$ref": "#/$defs/opacity" },
        "transcripts": {
          "type": "boolean",
          "description": "Show the transcript overlay (Xenium, Atera)."
        }
      },
      "additionalProperties": false
    }
  }
}
