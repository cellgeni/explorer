{
  "$schema": "https://cellgeni.github.io/explorer/schemas/explorer-collection.v1.json",
  "version": 1,
  "name": "Spinal cord Xenium time course (SPCOX)",
  "description": "Eighteen Xenium sections of spinal cord on a 474-gene panel, three per time point (Sham, 1, 3, 7, 14 and 28 dpi), and the snRNA-seq atlas they are compared with, as published by the Bayraktar group on WebAtlas.",
  "source": {
    "repository": "WebAtlas (sciatlas.org)",
    "accession": "SPCOX",
    "url": "https://www.sciatlas.org/SPCOX/"
  },
  "root": "https://spco.cog.sanger.ac.uk/SPCOX/",
  "datasets": [
    {
      "dataset": "SPCOX-Sham-A-anndata.zarr",
      "name": "Sham-A",
      "group": "Sham"
    },
    {
      "dataset": "SPCOX-Sham-B-anndata.zarr",
      "name": "Sham-B",
      "group": "Sham"
    },
    {
      "dataset": "SPCOX-Sham-C-anndata.zarr",
      "name": "Sham-C",
      "group": "Sham"
    },
    {
      "dataset": "SPCOX-1dpi-A-anndata.zarr",
      "name": "1dpi-A",
      "group": "1 dpi"
    },
    {
      "dataset": "SPCOX-1dpi-B-anndata.zarr",
      "name": "1dpi-B",
      "group": "1 dpi"
    },
    {
      "dataset": "SPCOX-1dpi-C-anndata.zarr",
      "name": "1dpi-C",
      "group": "1 dpi"
    },
    {
      "dataset": "SPCOX-3dpi-A-anndata.zarr",
      "name": "3dpi-A",
      "group": "3 dpi"
    },
    {
      "dataset": "SPCOX-3dpi-B-anndata.zarr",
      "name": "3dpi-B",
      "group": "3 dpi"
    },
    {
      "dataset": "SPCOX-3dpi-C-anndata.zarr",
      "name": "3dpi-C",
      "group": "3 dpi"
    },
    {
      "dataset": "SPCOX-7dpi-A-anndata.zarr",
      "name": "7dpi-A",
      "group": "7 dpi"
    },
    {
      "dataset": "SPCOX-7dpi-B-anndata.zarr",
      "name": "7dpi-B",
      "group": "7 dpi"
    },
    {
      "dataset": "SPCOX-7dpi-C-anndata.zarr",
      "name": "7dpi-C",
      "group": "7 dpi"
    },
    {
      "dataset": "SPCOX-14dpi-A-anndata.zarr",
      "name": "14dpi-A",
      "group": "14 dpi"
    },
    {
      "dataset": "SPCOX-14dpi-B-anndata.zarr",
      "name": "14dpi-B",
      "group": "14 dpi"
    },
    {
      "dataset": "SPCOX-14dpi-C-anndata.zarr",
      "name": "14dpi-C",
      "group": "14 dpi"
    },
    {
      "dataset": "SPCOX-28dpi-A-anndata.zarr",
      "name": "28dpi-A",
      "group": "28 dpi"
    },
    {
      "dataset": "SPCOX-28dpi-B-repeat2-anndata.zarr",
      "name": "28dpi-B-repeat2",
      "group": "28 dpi"
    },
    {
      "dataset": "SPCOX-28dpi-C-anndata.zarr",
      "name": "28dpi-C",
      "group": "28 dpi"
    },
    {
      "dataset": "SPCO-snRNAseq-anndata.zarr",
      "name": "snRNA-seq atlas",
      "group": "snRNA-seq"
    }
  ],
  "defaults": {
    "genes": ["Aqp4"],
    "cellPointScale": 2
  }
}
